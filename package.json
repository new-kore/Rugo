{
  "name": "rugo",
  "version": "1.0.0",
  "private": true,
  "description": "Rugo — on-demand freight. Shippers request pickups, carriers accept instantly, everyone tracks in real time.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "reset": "node -e \"require('fs').rmSync('data',{recursive:true,force:true})\"",
    "build:standalone": "node scripts/standalone.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^6.4.5"
  }
}
